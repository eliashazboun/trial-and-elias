{
  "name": "trial-and-elias",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run && npm run test --workspaces --if-present",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:game": "npm run test:e2e --workspace one-minute-dungeon",
    "dev:worker": "npm run build && node scripts/worker.mjs dev",
    "worker:serve": "node scripts/worker.mjs dev",
    "deploy": "npm run build && node scripts/worker.mjs deploy",
    "deploy:dry-run": "npm run build && node scripts/worker.mjs dry-run",
    "audit:public": "node scripts/audit.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.6",
    "vitest": "^3.0.5",
    "prettier": "3.5.3",
    "wrangler": "4.168.0"
  },
  "packageManager": "npm@11.8.0"
}
